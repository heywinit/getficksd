{
  "name": "getficksd",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@trpc/server": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "better-auth": "1.7.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev:bare",
    "dev:python": "cd apps/python && uv run uvicorn app.main:app --reload --port 8000",
    "dev:smtp": "docker compose up -d smtp",
    "dev:smtp:down": "docker compose stop smtp",
    "dev:smtp:logs": "docker compose logs -f smtp",
    "check:python": "cd apps/python && uv run ruff check . && uv run pytest",
    "db:push": "vp run --filter @getficksd/db db:push",
    "db:studio": "vp run --filter @getficksd/db db:studio",
    "db:generate": "vp run --filter @getficksd/db db:generate",
    "db:migrate": "vp run --filter @getficksd/db db:migrate",
    "db:seed": "vp run --filter @getficksd/db db:seed",
    "db:reset": "vp run --filter @getficksd/db db:reset",
    "deploy": "vp run --filter @getficksd/infra deploy",
    "destroy": "vp run --filter @getficksd/infra destroy"
  },
  "dependencies": {
    "@getficksd/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@getficksd/config": "workspace:*",
    "@types/node": "catalog:",
    "rolldown": "1.2.6",
    "typescript": "catalog:",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "packageManager": "bun@1.3.14"
}
